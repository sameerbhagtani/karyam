PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/karya
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173

# JWT Authentication
ACCESS_TOKEN_SECRET=super_secret_access_jwt_key_change_in_production
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_change_in_production

# -----------------------------------------------------------------------------
# Brevo (formerly Sendinblue) Transactional Email Configuration
# -----------------------------------------------------------------------------
# Brevo v3 API Key (starts with xkeysib-...)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here

# Verified Sender Email & Name in Brevo (must be verified under Senders & IP)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME="Karya"

# Dispatch Mode:
# - false: Uses the official @getbrevo/brevo SDK (BrevoClient)
# - true:  Uses direct Brevo REST HTTP API (https://api.brevo.com/v3/smtp/email)
BREVO_USE_HTTP=false

# Enable/Disable real email sending:
# - true:  Sends live emails via Brevo
# - false: Logs email payload to console in development without sending
SEND_MAIL=false

# Legacy SMTP Settings (fallback if BREVO_API_KEY is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER="karya <noreply@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# AWS S3 / MinIO Storage
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET_NAME=karyam-uploads

