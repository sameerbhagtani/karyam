PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/karya
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173

# JWT Authentication
ACCESS_TOKEN_SECRET=super_secret_access_jwt_key_change_in_production
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_change_in_production

# Brevo / Mail Settings
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME="Karya"
BREVO_USE_HTTP=false
SEND_MAIL=false

# Legacy SMTP Settings (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER="karya <noreply@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=karyam-uploads
AWS_ENDPOINT=

# Mistral AI (Embeddings)
MISTRAL_API_KEY=

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_INDEX_NAME=karyam-index